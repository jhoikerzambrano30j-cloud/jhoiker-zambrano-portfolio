# ============================================================
#  JHOIKER ZAMBRANO — Variables de entorno
#  Copia este archivo como .env.local y rellena los valores.
#  En Vercel: Project Settings → Environment Variables
# ============================================================

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo servidor. NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL=https://jhoiker-zambrano-portfolio.vercel.app
NEXT_PUBLIC_SITE_NAME=Jhoiker Zambrano
NEXT_PUBLIC_CONTACT_EMAIL=contacto@jhoikerzambrano.com
NEXT_PUBLIC_WHATSAPP=+57

# ---- Datos del propietario (contratos) ----
NEXT_PUBLIC_OWNER_NAME=Jhoiker Zambrano
NEXT_PUBLIC_OWNER_ID=
NEXT_PUBLIC_OWNER_CITY=

# ---- Admin inicial (solo lo usa scripts/seed-admin.mjs) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Jhoiker Zambrano

# ---- Supabase Management API (aplica el SQL automáticamente) ----
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ---- GitHub (publica el repositorio automáticamente) ----
# https://github.com/settings/tokens  → token clásico con permiso «repo»
# Solo se usan los scripts locales; NO hacen falta en Vercel.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=jhoiker-zambrano-portfolio
GITHUB_BRANCH=main

